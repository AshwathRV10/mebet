# Copy to .env and edit. Nothing here is required to run the application:
# every setting has a working default, and absent API keys simply mean the
# sources that need them report themselves unavailable.

# --- storage ---------------------------------------------------------------
# MEBET_DATABASE_URL=sqlite:///data/mebet.db
# Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/mebet
# MEBET_DATA_DIR=data
# MEBET_CACHE_DIR=data/http_cache
# MEBET_LOG_DIR=logs

# --- server ----------------------------------------------------------------
# Bind to 127.0.0.1 for local-only use; 0.0.0.0 to expose on a LAN.
# MEBET_HOST=127.0.0.1
# MEBET_PORT=8000
# MEBET_LOG_LEVEL=INFO

# --- data acquisition -------------------------------------------------------
# Identify yourself to the sources you fetch from. Please set a real contact.
# MEBET_USER_AGENT=mebet/0.1 (personal analytics; you@example.com)
# MEBET_HTTP_TIMEOUT=30
# MEBET_HTTP_RETRIES=3
# MEBET_CACHE_TTL=21600
# MEBET_RESPECT_ROBOTS=true
# Serve from cache only, never hit the network:
# MEBET_OFFLINE=false
# Restrict which sources are used (comma separated keys):
# MEBET_ENABLED_SOURCES=datahub_footballdata,fpl_mirror,fpl_api,open_meteo

# --- optional API keys ------------------------------------------------------
# These are read only by the backend and are never sent to the browser.
# FOOTBALL_DATA_ORG_KEY=
# API_FOOTBALL_KEY=

# --- modelling --------------------------------------------------------------
# Half-life in days for time-decay weighting of historical matches.
# MEBET_HALF_LIFE_DAYS=270
# MEBET_MC_ITERATIONS=20000
# MEBET_RANDOM_SEED=20240917
